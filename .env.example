# =========================================================================
# IntellMeet Monorepo Environment Configuration Template
# Copy this template to create your local environment files:
#   cp .env.example server/.env
#   cp client/.env.example client/.env
# =========================================================================

# --- Backend Configuration (server/.env) ---
PORT=5001
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string

# Authentication Secrets
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173

# Speech AI & Transcription ('mock' | 'gemini' | 'openai' | 'deepgram')
TRANSCRIPTION_PROVIDER=mock
AI_PROVIDER=mock
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
MAX_AUDIO_UPLOAD_SIZE_MB=25

# Cloudinary Media Storage (User Avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MAX_IMAGE_UPLOAD_SIZE_MB=5

# Redis Pub/Sub for Multi-Instance Socket.io (Optional for local dev)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Observability (Optional)
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true

# --- Frontend Configuration (client/.env) ---
VITE_API_BASE_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001
