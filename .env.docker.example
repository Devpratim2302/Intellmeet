# =========================================================================
# IntellMeet Docker Environment Configuration Template
# Copy this file to .env.docker for custom configuration:
#   cp .env.docker.example .env.docker
# =========================================================================

# Backend Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB Database Connection
# In Docker Compose, 'mongodb' is the service hostname inside the docker network
MONGODB_URI=mongodb://mongodb:27017/intellmeet_dev

# JWT Authentication Secrets (Replace with cryptographically strong values for production)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# AI & Speech Transcription Providers
# Options: 'mock' (default, runs self-contained locally) | 'gemini' | 'openai' | 'deepgram'
TRANSCRIPTION_PROVIDER=mock
AI_PROVIDER=mock
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
MAX_AUDIO_UPLOAD_SIZE_MB=25

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MAX_IMAGE_UPLOAD_SIZE_MB=5

# Frontend Build Arguments (Vite)
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=http://localhost:5001
