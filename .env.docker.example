# =========================================================================
# IntellMeet Docker Environment Configuration Template
# Copy this file to .env.docker for custom configuration:
#   cp .env.docker.example .env.docker
# =========================================================================

# Backend Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB Database Connection
# In Docker Compose, 'mongodb' is the service hostname inside the docker network
MONGODB_URI=mongodb://mongodb:27017/intellmeet_dev

# JWT Authentication Secrets (Replace with cryptographically strong values for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# AI & Speech Transcription Providers
# Options: 'mock' (default, runs self-contained locally) | 'openai' | 'deepgram'
TRANSCRIPTION_PROVIDER=mock
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
MAX_AUDIO_UPLOAD_SIZE_MB=25

# Frontend Build Arguments (Vite)
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=http://localhost:5001
