# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string

# JWT Secrets (Generate strong random keys for production)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Google OAuth Credentials (Tutorial: https://youtu.be/TjMhPr59qn4)
# Setup in Google Cloud Console: https://console.cloud.google.com/
# Authorized JS Origins: http://localhost:5173
# Authorized Redirect URIs: http://localhost:5173/auth/google/callback, http://localhost:5001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# AI Transcription Provider Options: 'mock' | 'gemini' | 'openai' | 'deepgram'
# Default: 'mock' (Runs locally without external credentials for rapid development & zero-cost testing)
TRANSCRIPTION_PROVIDER=mock

# Provider Credentials (Optional - activated when provider is set accordingly)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
MAX_AUDIO_UPLOAD_SIZE_MB=25

# AI Meeting Summary & Action Items Provider ('mock' | 'gemini' | 'openai')
# Default: 'mock' (Analyzes transcript locally without external credentials)
AI_PROVIDER=mock
AI_MODEL=gemini-3.8-flash

# Cloudinary Media Storage (User Avatars & Profile Media)
# When credentials are omitted, a self-contained mock storage engine is used locally
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MAX_IMAGE_UPLOAD_SIZE_MB=5
