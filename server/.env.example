# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/intellmeet_dev

# JWT Secrets (Generate strong random keys for production)
JWT_ACCESS_SECRET=intellmeet_access_super_secret_dev_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=intellmeet_refresh_super_secret_dev_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# AI Transcription Provider Options: 'mock' | 'openai' | 'deepgram'
# Default: 'mock' (Runs locally without external credentials for rapid development & zero-cost testing)
TRANSCRIPTION_PROVIDER=mock

# Paid Provider Credentials (Optional - activated when TRANSCRIPTION_PROVIDER is set accordingly)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
MAX_AUDIO_UPLOAD_SIZE_MB=25

# AI Meeting Summary & Action Items Provider ('mock' | 'openai')
# Default: 'mock' (Analyzes transcript locally without external credentials)
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini

# Cloudinary Media Storage (User Avatars & Profile Media)
# When credentials are omitted, a self-contained mock storage engine is used locally
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_IMAGE_UPLOAD_SIZE_MB=5
